FROM python:3.11-slim

WORKDIR /bootstrap

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

COPY requirements-models.txt /bootstrap/requirements-models.txt

RUN python -m pip install \
    --no-cache-dir \
    --upgrade \
    pip \
    setuptools \
    wheel \
    && python -m pip install \
    --no-cache-dir \
    -r /bootstrap/requirements-models.txt

COPY scripts/download_models.py /bootstrap/download_models.py

CMD ["python", "/bootstrap/download_models.py"]