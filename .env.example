APP_NAME=corporate-avatar-service
APP_ENV=dev
API_KEY=change_me

POSTGRES_DB=avatar_db
POSTGRES_USER=avatar_user
POSTGRES_PASSWORD=avatar_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://avatar_user:avatar_pass@db:5432/avatar_db

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_QUEUE_NAME=avatar_jobs
CELERY_VISIBILITY_TIMEOUT=7200

STORAGE_DIR=/app/storage
MAX_IMAGE_MB=10
NORMALIZED_IMAGE_MAX_SIDE=2048

INSIGHTFACE_ROOT=/models/insightface
INSIGHTFACE_MODEL_NAME=antelopev2
INSIGHTFACE_SWAP_MODEL_NAME=buffalo_l

INSWAPPER_MODEL_NAME=inswapper_128.onnx
INSWAPPER_REPO_ID=ezioruan/inswapper_128.onnx
INSWAPPER_REVISION=6ffdf0e83c5996cc425e77b59913fc48d79441be
INSWAPPER_SHA256=e4a3f08c753cb72d04e10aa0f7dbe3deebbf39567d4ead6dce08e98aa49e16af

FACE_DETECTION_WIDTH=640
FACE_DETECTION_HEIGHT=640
FACE_DETECTION_THRESHOLD=0.35
FACE_MIN_AREA_RATIO=0.008

SECONDARY_FACE_MIN_SCORE=0.65
SECONDARY_FACE_MIN_AREA_RATIO=0.25

FACE_SWAP_ENABLED=true
FACE_SWAP_PIXEL_BOOST_SIZE=512
FACE_SWAP_MASK_BLUR_RATIO=0.025
FACE_SWAP_MASK_DILATION_RATIO=0.015
FACE_SWAP_COLOR_MATCH_STRENGTH=0.45
FACE_SWAP_MIN_SHARPNESS_RATIO=0.72
FACE_SWAP_MIN_IDENTITY_GAIN=0.015
FACE_SWAP_MAX_IDENTITY_DROP=0.020
FACE_SWAP_TOP_K=2

FACE_IDENTITY_ANTELOPE_THRESHOLD=0.60
FACE_IDENTITY_BUFFALO_THRESHOLD=0.58
FACE_IDENTITY_MEAN_THRESHOLD=0.61
IDENTITY_QUALITY_TIE_MARGIN=0.012

KEEP_CANDIDATE_FILES=true

AI_BATCH_SCRIPT_PATH=/app/scripts/ai_service.py
AI_TIMEOUT_SECONDS=7200
AI_CANDIDATE_SEEDS=44,144,244
AI_NUM_INFERENCE_STEPS=50
AI_GUIDANCE_SCALE=5.0
AI_OUTPUT_SIZE=512
AI_CPU_THREADS=8
AI_CUDA_DEVICE_INDEX=0
AI_CONSISTENTID_ADAPTER_SCALE=1.00
AI_CONSISTENTID_START_MERGE_STEP=30

AI_CONTROLNET_ENABLED=true
AI_CONTROLNET_MODEL_ID=lllyasviel/control_v11p_sd15_openpose
AI_CONTROLNET_REVISION=9ae9f970358db89e211b87c915f9535c6686d5ba
AI_CONTROLNET_MODEL_DIR=/models/controlnet_openpose
AI_CONTROLNET_CONDITIONING_SCALE=0.35
AI_CONTROLNET_GUIDANCE_START=0.0
AI_CONTROLNET_GUIDANCE_END=0.62

BACKGROUND_MATTING_ENABLED=true
BACKGROUND_MATTING_REQUIRED=true
BACKGROUND_MATTING_SCRIPT_PATH=/app/scripts/background_matting.py
BACKGROUND_MATTING_TIMEOUT_SECONDS=1800
BACKGROUND_MATTING_MODEL=birefnet-portrait
BACKGROUND_MATTING_THREADS=6
BACKGROUND_MATTING_MODEL_DIR=/models/rembg
CORPORATE_BACKGROUND_HEX=D5E0E8
BACKGROUND_MATTING_ALPHA_GAMMA=1.0
BACKGROUND_MATTING_MIN_FOREGROUND_RATIO=0.10
BACKGROUND_MATTING_MAX_FOREGROUND_RATIO=0.98
KEEP_BACKGROUND_MASK=false

MODEL_CLEANUP_ENABLED=true
MODELS_ROOT=/models

AI_BASE_MODEL_ID=SG161222/Realistic_Vision_V6.0_B1_noVAE
AI_BASE_MODEL_REVISION=main
AI_BASE_MODEL_DIR=/models/base_model

AI_VAE_MODEL_ID=stabilityai/sd-vae-ft-mse
AI_VAE_MODEL_REVISION=main
AI_VAE_MODEL_DIR=/models/vae

AI_CLIP_MODEL_ID=laion/CLIP-ViT-H-14-laion2B-s32B-b79K
AI_CLIP_MODEL_REVISION=main
AI_CLIP_MODEL_DIR=/models/clip_vision

CONSISTENTID_REPO_ID=JackAILab/ConsistentID
CONSISTENTID_REVISION=main
CONSISTENTID_MODEL_DIR=/models/consistentid
CONSISTENTID_WEIGHT_NAME=ConsistentID-v1.bin
CONSISTENTID_FACE_PARSING_NAME=face_parsing.pth

REMBG_MODEL_DIR=/models/rembg
REMBG_MODEL_NAME=birefnet-portrait.onnx
REMBG_MODEL_URL=https://github.com/danielgatis/rembg/releases/download/v0.0.0/BiRefNet-portrait-epoch_150.onnx
REMBG_MODEL_MD5=c3a64a6abf20250d090cd055f12a3b67

PIPELINE_VERSION=sd15-consistentid-v1-official-fp32-openpose-birefnet-v17

HF_TOKEN=